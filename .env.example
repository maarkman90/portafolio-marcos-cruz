# Copia este archivo como ".env" y reemplaza el valor con tu token real
# obtenido en Cloudflare Zero Trust > Networks > Tunnels > (tu tunnel) > Install connector.
#
# IMPORTANTE: El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

CLOUDFLARE_TUNNEL_TOKEN=pega_aqui_tu_token_del_tunnel
